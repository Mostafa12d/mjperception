<mujoco model="door">
  <!-- Same door as door_iiwa_scene.xml, minus the KUKA iiwa arm — for
       perception-only testing (point cloud / FlowBot3D) where the robot
       would otherwise occlude the camera or clutter segmentation. -->
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <global azimuth="-140" elevation="-18" offwidth="960" offheight="720"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.8 0.9 1" rgb2="0.3 0.4 0.5" width="256" height="256"/>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.2 0.2 0.2" rgb2="0.3 0.3 0.3" width="300" height="300"/>
    <material name="grid" texture="grid" texrepeat="5 5" reflectance="0.1"/>
  </asset>

  <worldbody>
    <light pos="0.5 -2 3" dir="0 0.4 -1" diffuse="1 1 1"/>
    <geom name="floor" type="plane" size="3 3 0.1" material="grid"/>

    <!-- Wall behind the hinge (visual only). -->
    <geom name="wall" type="box" pos="-0.02 0 1.0" size="0.02 0.6 1.0"
          rgba="0.5 0.5 0.5 1" contype="0" conaffinity="0"/>

    <!-- Door: hinge at world origin, panel in the XZ plane, opens about +Z. -->
    <body name="door" pos="0 0 0">
      <joint name="hinge" type="hinge" pos="0 0 0" axis="0 0 1"
             limited="true" range="-0.17 2.09"
             damping="0.2" frictionloss="3.0"/>
      <geom name="panel" type="box" pos="0.45 0 1.02" size="0.45 0.02 1.0"
            density="600" rgba="0.8 0.7 0.5 1" contype="0" conaffinity="0"/>
      <!-- Real handle geom (not just the site below): a flat panel alone
           gives depth cameras zero 3D structure to key on. Protrudes 6cm
           off the panel face. -->
      <geom name="handle" type="box" pos="0.85 -0.05 1.0" size="0.02 0.03 0.15"
            density="600" rgba="0.15 0.15 0.15 1" contype="0" conaffinity="0"/>
      <site name="handle" pos="0.85 0 1.0" size="0.03" rgba="1 0 0 1"/>
    </body>

    <!-- Wide scene view. -->
    <camera name="view" pos="-0.5 -1.5 2.5" xyaxes="0.97 0.24 0 -0.14 0.56 0.82"/>

    <!-- Presentation camera: 3/4 elevated view framing the door. -->
    <camera name="flowbot_view" pos="1.3 -2.0 2.0" xyaxes="0.9328 0.3605 0 -0.1407 0.3640 0.9206"/>

    <!-- RGB-D camera: 3/4-angle view of the door panel for perception (e.g.
         FlowBot3D). A dead-on frontal view of a flat panel gives a depth
         image with ~zero depth variation across every pixel -- angled
         off-axis instead so there's real depth gradient across the
         visible surface. -->
    <body name="rgbd_camera_mount" pos="-0.9 -1.6 1.3"
          xyaxes="0.7643 -0.6449 0 0.0855 0.1013 0.9912">
      <include file="rgbd_camera.xml"/>
    </body>
  </worldbody>
</mujoco>

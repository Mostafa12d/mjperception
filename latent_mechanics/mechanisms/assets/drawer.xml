<mujoco model="prismatic_drawer">
  <compiler angle="radian"/>
  <option timestep="0.002" gravity="0 0 -9.81"/>
  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.8 0.9 1" rgb2="0.3 0.4 0.5" width="256" height="256"/>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.2 0.2 0.2" rgb2="0.3 0.3 0.3" width="300" height="300"/>
    <material name="grid" texture="grid" texrepeat="5 5" reflectance="0.1"/>
  </asset>
  <worldbody>
    <light pos="0 -1 3" dir="0 0.3 -1" diffuse="1 1 1"/>
    <geom name="floor" type="plane" size="3 3 0.1" material="grid"/>
    <!-- Cabinet carcass: visual only, no collision. -->
    <geom name="carcass" type="box" pos="0 0.35 0.5" size="0.35 0.02 0.5"
          rgba="0.45 0.45 0.45 1" contype="0" conaffinity="0"/>
    <!-- Drawer body: origin at the closed position; slides along +x. -->
    <body name="door" pos="0 0 0.5">
      <joint name="hinge" type="slide" pos="0 0 0" axis="1 0 0"
             limited="true" range="0 0.5" damping="4.0" frictionloss="8.0"/>
      <geom name="panel" type="box" pos="0 0 0" size="0.30 0.25 0.10"
            density="500" rgba="0.75 0.6 0.45 1" contype="0" conaffinity="0"/>
      <site name="handle" pos="0.31 0 0" size="0.02" rgba="1 0 0 1"/>
    </body>
    <camera name="view" pos="1.6 -1.8 1.3" xyaxes="1 0.9 0 0 0.4 1"/>
  </worldbody>
</mujoco>

<mujoco model="bifold_cabinet">
  <compiler angle="radian"/>
  <option timestep="0.002" gravity="0 0 -9.81"/>
  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.8 0.9 1" rgb2="0.3 0.4 0.5" width="256" height="256"/>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.2 0.2 0.2" rgb2="0.3 0.3 0.3" width="300" height="300"/>
    <material name="grid" texture="grid" texrepeat="5 5" reflectance="0.1"/>
  </asset>
  <worldbody>
    <light pos="0 -1 3" dir="0 0.3 -1" diffuse="1 1 1"/>
    <geom name="floor" type="plane" size="3 3 0.1" material="grid"/>
    <!-- Two-link bi-fold cabinet door. ONLY the first hinge is actuated and
         observed; the second panel swings freely and its state is hidden.
         That makes the observed (q, qdot) non-Markov by construction. -->
    <body name="door" pos="0 0 0">
      <joint name="hinge" type="hinge" pos="0 0 0" axis="0 0 1"
             limited="true" range="-0.17 2.09" damping="0.2" frictionloss="2.0"/>
      <geom name="panel" type="box" pos="0.225 0 1.02" size="0.225 0.02 1.0"
            density="600" rgba="0.8 0.7 0.5 1" contype="0" conaffinity="0"/>
      <site name="handle" pos="0.45 0 1.0" size="0.03" rgba="1 0 0 1"/>
      <body name="leaf" pos="0.45 0 0">
        <joint name="leaf_hinge" type="hinge" pos="0 0 0" axis="0 0 1"
               limited="true" range="-2.0 0.0" damping="0.15" frictionloss="1.0"/>
        <geom name="leaf_panel" type="box" pos="0.225 0 1.02" size="0.225 0.02 1.0"
              density="600" rgba="0.7 0.6 0.45 1" contype="0" conaffinity="0"/>
      </body>
    </body>
    <camera name="view" pos="2.5 -2.8 2.2" xyaxes="1 0.9 0 0 0.4 1"/>
  </worldbody>
</mujoco>

<mujoco model="laptop_hinge">
  <compiler angle="radian"/>
  <option timestep="0.002" gravity="0 0 -9.81"/>
  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.8 0.9 1" rgb2="0.3 0.4 0.5" width="256" height="256"/>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.2 0.2 0.2" rgb2="0.3 0.3 0.3" width="300" height="300"/>
    <material name="grid" texture="grid" texrepeat="5 5" reflectance="0.1"/>
  </asset>
  <worldbody>
    <light pos="0 -1 3" dir="0 0.3 -1" diffuse="1 1 1"/>
    <geom name="floor" type="plane" size="3 3 0.1" material="grid"/>
    <geom name="base" type="box" pos="0 0.11 0.005" size="0.15 0.11 0.005"
          rgba="0.3 0.3 0.32 1" contype="0" conaffinity="0"/>
    <!-- Screen: small inertia, friction-dominated, stays where you put it.
         Hinge axis along x at the rear edge of the base. -->
    <body name="door" pos="0 0 0.01">
      <joint name="hinge" type="hinge" pos="0 0 0" axis="1 0 0"
             limited="true" range="0 2.2" damping="0.02" frictionloss="0.35"/>
      <geom name="panel" type="box" pos="0 0 0.10" size="0.15 0.005 0.10"
            density="700" rgba="0.25 0.25 0.28 1" contype="0" conaffinity="0"/>
      <site name="handle" pos="0 0 0.20" size="0.01" rgba="1 0 0 1"/>
    </body>
    <camera name="view" pos="0.8 -0.9 0.5" xyaxes="1 0.9 0 0 0.4 1"/>
  </worldbody>
</mujoco>

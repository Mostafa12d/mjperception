<mujoco model="desk_drawer_scene">
  <!-- Static visual scene for the scanned desk drawer asset (Scaniverse mesh,
       desk_drawer/desk_drawer.obj + desk_drawer.jpg). The scan is a single
       fused mesh (not segmented into carcass + drawer), so it's placed as one
       static body -- no joints. Good for perception/camera testing
       (OMIP/flowbot3d style pipelines), not for manipulation dynamics. -->
  <compiler angle="radian" meshdir="desk_drawer" texturedir="desk_drawer"/>
  <option timestep="0.002" gravity="0 0 -9.81"/>

  <visual>
    <global offwidth="960" offheight="720"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.8 0.9 1" rgb2="0.3 0.4 0.5" width="256" height="256"/>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.2 0.2 0.2" rgb2="0.3 0.3 0.3" width="300" height="300"/>
    <material name="grid" texture="grid" texrepeat="5 5" reflectance="0.1"/>

    <mesh name="desk_drawer" file="desk_drawer.obj"/>
    <texture name="desk_drawer_tex" type="2d" file="desk_drawer.png"/>
    <material name="desk_drawer_mat" texture="desk_drawer_tex" specular="0.1" shininess="0.05"/>
  </asset>

  <worldbody>
    <light pos="0 -1 3" dir="0 0.3 -1" diffuse="1 1 1"/>
    <geom name="floor" type="plane" size="3 3 0.1" material="grid"/>

    <!-- Raw scan vertices sit in the scanner's own frame (roughly
         x:[0.29,0.63] y:[0.34,0.96] z:[0.12,0.61]) with the drawer face
         pointing +z (sky) and its back pointing -z (ground) -- i.e. it was
         scanned lying on its back. quat rotates +90 deg about x so the face
         normal points -y (toward the "view"/"rgbd" cameras) and the object
         stands upright; pos then recenters x/y and drops the new lowest
         point onto the floor. -->
    <body name="desk_drawer" pos="-0.459425 0.36779 -0.34453" quat="0.70710678 0.70710678 0 0">
      <geom name="desk_drawer_geom" type="mesh" mesh="desk_drawer" material="desk_drawer_mat"
            contype="0" conaffinity="0"/>
    </body>

    <camera name="view" pos="1.2 -1.25 0.77" xyaxes="0.707 0.707 0 -0.183 0.183 0.966"/>

    <body name="camera_mount" pos="1.2 -1.25 0.77" xyaxes="0.707 0.707 0 -0.183 0.183 0.966">
      <include file="rgbd_camera.xml"/>
    </body>
  </worldbody>
</mujoco>

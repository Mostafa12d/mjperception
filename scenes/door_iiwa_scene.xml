<mujoco model="door_iiwa">
  <!-- Door at origin; KUKA iiwa stands in front (−Y) and reaches the handle.
       EE flange welded to handle — no gripper. -->
  <compiler angle="radian" meshdir="kuka_iiwa_14/assets" autolimits="true"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <global azimuth="-140" elevation="-18" offwidth="960" offheight="720"/>
  </visual>

  <default>
    <default class="iiwa">
      <material specular="0.5" shininess="0.25"/>
      <joint axis="0 0 1"/>
      <default class="joint1">
        <joint range="-2.96706 2.96706"/>
        <default class="joint2">
          <joint range="-2.0944 2.0944"/>
        </default>
      </default>
      <default class="joint3">
        <joint range="-3.05433 3.05433"/>
      </default>
      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2" material="gray"/>
      </default>
      <default class="collision">
        <!-- Collisions off — weld couples the systems; avoid contact fighting the weld. -->
        <geom group="3" contype="0" conaffinity="0"/>
      </default>
      <site size="0.001" rgba="1 0 0 1" group="4"/>
    </default>
  </default>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.8 0.9 1" rgb2="0.3 0.4 0.5" width="256" height="256"/>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.2 0.2 0.2" rgb2="0.3 0.3 0.3" width="300" height="300"/>
    <material name="grid" texture="grid" texrepeat="5 5" reflectance="0.1"/>

    <material class="iiwa" name="gray" rgba="0.4 0.4 0.4 1"/>
    <material class="iiwa" name="light_gray" rgba="0.6 0.6 0.6 1"/>
    <material class="iiwa" name="black" rgba="0 0 0 1"/>
    <material class="iiwa" name="orange" rgba="1 0.423529 0.0392157 1"/>

    <mesh file="link_0.obj"/>
    <mesh file="link_1.obj"/>
    <mesh file="link_2_orange.obj"/>
    <mesh file="link_2_grey.obj"/>
    <mesh file="link_3.obj"/>
    <mesh file="band.obj"/>
    <mesh file="kuka.obj"/>
    <mesh file="link_4_orange.obj"/>
    <mesh file="link_4_grey.obj"/>
    <mesh file="link_5.obj"/>
    <mesh file="link_6_orange.obj"/>
    <mesh file="link_6_grey.obj"/>
    <mesh file="link_7.obj"/>
  </asset>

  <worldbody>
    <light pos="0.5 -2 3" dir="0 0.4 -1" diffuse="1 1 1"/>
    <geom name="floor" type="plane" size="3 3 0.1" material="grid"/>

    <!-- Wall behind the hinge (visual only). -->
    <geom name="wall" type="box" pos="-0.02 0 1.0" size="0.02 0.6 1.0"
          rgba="0.5 0.5 0.5 1" contype="0" conaffinity="0"/>

    <!-- Door: hinge at world origin, panel in the XZ plane, opens about +Z. -->
    <body name="door" pos="0 0 0">
      <joint name="hinge" type="hinge" pos="0 0 0" axis="0 0 1"
             limited="true" range="-0.17 2.09"
             damping="0.2" frictionloss="3.0"/>
      <geom name="panel" type="box" pos="0.45 0 1.02" size="0.45 0.02 1.0"
            density="600" rgba="0.8 0.7 0.5 1" contype="0" conaffinity="0"/>
      <!-- Real handle geom (not just the "handle" site below): a flat door
           panel alone gives depth cameras zero 3D structure to key on, so
           FlowBot3D had nothing to distinguish the free/handle edge from
           the hinge edge. This protrudes 6cm off the panel face. -->
      <geom name="handle" type="box" pos="0.85 -0.05 1.0" size="0.02 0.03 0.15"
            density="600" rgba="0.15 0.15 0.15 1" contype="0" conaffinity="0"/>
      <site name="handle" pos="0.85 0 1.0" size="0.03" rgba="1 0 0 1"/>
    </body>

    <!-- KUKA iiwa 14: base placed so the arm can cover the full 0-90° door arc.
         Base at (0.48, 0.35, 0) yawed -43.4° — arm reaches handle at θ=0 and
         follows it to θ=90° without leaving the workspace. -->
    <body name="base" pos="0.48 0.35 0.0" quat="0.92913257 0 0 -0.36974676" childclass="iiwa">
      <inertial mass="5" pos="-0.1 0 0.07" diaginertia="0.05 0.06 0.03"/>
      <geom class="visual" mesh="link_0"/>
      <geom class="collision" size="0.12" pos="0 0 0.03"/>
      <body name="link1" pos="0 0 0.1575">
        <inertial mass="5.76" pos="0 -0.03 0.12" diaginertia="0.0333 0.033 0.0123"/>
        <joint name="joint1" class="joint1"/>
        <geom class="visual" mesh="link_1"/>
        <geom class="collision" size="0.08" pos="0 0 -0.0005"/>
        <body name="link2" pos="0 0 0.2025" quat="0 0 1 1">
          <inertial mass="6.35" pos="0.0003 0.059 0.042" diaginertia="0.0305 0.0304 0.011" quat="0 0 1 1"/>
          <joint name="joint2" class="joint2"/>
          <geom class="visual" material="orange" mesh="link_2_orange"/>
          <geom class="visual" mesh="link_2_grey"/>
          <geom class="collision" size="0.095" pos="0 0 -0.01"/>
          <body name="link3" pos="0 0.2045 0" quat="0 0 1 1">
            <inertial mass="3.5" pos="0 0.03 0.13" diaginertia="0.025 0.0238 0.0076"/>
            <joint name="joint3" class="joint1"/>
            <geom class="visual" mesh="link_3"/>
            <geom class="visual" material="light_gray" mesh="band"/>
            <geom class="visual" material="black" mesh="kuka"/>
            <geom class="collision" size="0.075" pos="0 0 0.0355"/>
            <body name="link4" pos="0 0 0.2155" quat="1 1 0 0">
              <inertial mass="3.5" pos="0 0.067 0.034" diaginertia="0.017 0.0164 0.006" quat="1 1 0 0"/>
              <joint name="joint4" class="joint2"/>
              <geom class="visual" material="orange" mesh="link_4_orange"/>
              <geom class="visual" mesh="link_4_grey"/>
              <geom class="collision" size="0.078" pos="0 0.01 0.046"/>
              <body name="link5" pos="0 0.1845 0" quat="0 0 1 1">
                <inertial mass="3.5" pos="0.0001 0.021 0.076" diaginertia="0.01 0.0087 0.00449"/>
                <joint name="joint5" class="joint1"/>
                <geom class="visual" mesh="link_5"/>
                <geom class="visual" material="light_gray" mesh="band"/>
                <geom class="visual" material="black" mesh="kuka"/>
                <geom class="collision" size="0.075" pos="0 0 0.0335"/>
                <body name="link6" pos="0 0 0.2155" quat="1 1 0 0">
                  <inertial mass="1.8" pos="0 0.0006 0.0004" diaginertia="0.0049 0.0047 0.0036" quat="1 1 0 0"/>
                  <joint name="joint6" class="joint2"/>
                  <geom class="visual" material="orange" mesh="link_6_orange"/>
                  <geom class="visual" mesh="link_6_grey"/>
                  <geom class="collision" size="0.08"/>
                  <body name="link7" pos="0 0.081 0" quat="0 0 1 1">
                    <inertial mass="1.2" pos="0 0 0.02" diaginertia="0.001 0.001 0.001"/>
                    <joint name="joint7" class="joint3"/>
                    <geom class="visual" mesh="link_7"/>
                    <geom class="collision" size="0.06" pos="0 0 0.001"/>
                    <!-- wrist F/T sensor cross-section: between joint7 and flange -->
                    <site name="wrist_ft" pos="0 0 0.01" size="0.006" rgba="0 1 0 0.8" group="4"/>
                    <site pos="0 0 0.045" name="attachment_site"/>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>

    <!-- Camera: looks across the scene showing robot beside door. -->
    <camera name="view" pos="-0.5 -1.5 2.5" xyaxes="0.97 0.24 0 -0.14 0.56 0.82"/>

    <!-- Presentation camera: 3/4 elevated view framing robot + door together
         (the "view" camera above is mis-framed and left untouched since
         run_door_adaptive_impedance.py already depends on it for video). -->
    <camera name="flowbot_view" pos="1.3 -2.0 2.0" xyaxes="0.9328 0.3605 0 -0.1407 0.3640 0.9206"/>

    <!-- RGB-D camera: 3/4-angle view of the door panel for perception (e.g.
         FlowBot3D). A dead-on frontal view of a flat panel gives a depth
         image with ~zero depth variation across every pixel (the whole
         visible face is coplanar) -- a degenerate, near-2D point cloud that
         starves the network of the geometric cues (edges, depth parallax)
         it was trained on. Angled off-axis instead, looking at the panel
         center from (-0.9,-1.6,1.3): still opposite the robot base (base is
         at y=+0.35) so the arm doesn't occlude the door, but with real
         depth gradient across the visible surface. -->
    <body name="rgbd_camera_mount" pos="-0.9 -1.6 1.3"
          xyaxes="0.7643 -0.6449 0 0.0855 0.1013 0.9912">
      <include file="rgbd_camera.xml"/>
    </body>
  </worldbody>

  <equality>
    <!-- Rigid weld: flange (link7) ↔ door at the grasp keyframe. -->
    <weld name="ee_to_handle" body1="link7" body2="door"
          relpose="0.89395617 -0.58412111 -0.71793229 0.70535506 -0.24070924 -0.60473762 0.28075918"
          solref="0.001 1" solimp="0.99 0.99 0.001 0.5 2"/>
  </equality>

  <actuator>
    <motor name="actuator1" joint="joint1" ctrlrange="-100 100"/>
    <motor name="actuator2" joint="joint2" ctrlrange="-100 100"/>
    <motor name="actuator3" joint="joint3" ctrlrange="-100 100"/>
    <motor name="actuator4" joint="joint4" ctrlrange="-100 100"/>
    <motor name="actuator5" joint="joint5" ctrlrange="-100 100"/>
    <motor name="actuator6" joint="joint6" ctrlrange="-100 100"/>
    <motor name="actuator7" joint="joint7" ctrlrange="-100 100"/>
  </actuator>

  <!-- qpos: hinge, j1..j7 — EE at handle, arm clear of the panel. -->
  <keyframe>
    <key name="grasp"
         qpos="0 -0.000127 0.095125 -0.000032 -0.944458 0.000003 0.377911 0.000000"
         ctrl="0 0 0 0 0 0 0"/>
  </keyframe>
</mujoco>

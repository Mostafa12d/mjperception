<mujoco model="single_hinge_door">
  <compiler angle="radian"/>
  <option timestep="0.002" gravity="0 0 -9.81"/>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.8 0.9 1" rgb2="0.3 0.4 0.5" width="256" height="256"/>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.2 0.2 0.2" rgb2="0.3 0.3 0.3" width="300" height="300"/>
    <material name="grid" texture="grid" texrepeat="5 5" reflectance="0.1"/>
  </asset>

  <worldbody>
    <light pos="0 -1 3" dir="0 0.3 -1" diffuse="1 1 1"/>
    <!-- Floor is visual + collision for other objects later; door must not scrape it. -->
    <geom name="floor" type="plane" size="3 3 0.1" material="grid"/>

    <!-- Static wall for visual context only — no collision (contype/conaffinity=0).
         Previously this jammed the door shut because the panel face sat flush against it. -->
    <geom name="wall" type="box" pos="-0.02 0 1.0" size="0.02 0.6 1.0"
          rgba="0.5 0.5 0.5 1" contype="0" conaffinity="0"/>

    <!-- Door body: origin IS the hinge location. -->
    <body name="door" pos="0 0 0">
      <joint name="hinge" type="hinge" pos="0 0 0" axis="0 0 1"
             limited="true" range="-0.17 2.09"
             damping="0.2" frictionloss="3.0"/>
      <!-- Panel raised 2 cm so the bottom edge clears the floor.
           Mass/inertia still computed from size + density. -->
      <geom name="panel" type="box" pos="0.45 0 1.02" size="0.45 0.02 1.0"
            density="600" rgba="0.8 0.7 0.5 1"/>
      <!-- Handle: force application point, away from the hinge. -->
      <site name="handle" pos="0.85 0 1.0" size="0.03" rgba="1 0 0 1"/>
    </body>

    <!-- Fixed camera looking down at the door from an angle that shows swing. -->
    <camera name="view" pos="2.5 -2.8 2.2" xyaxes="1 0.9 0 0 0.4 1"/>
  </worldbody>
</mujoco>

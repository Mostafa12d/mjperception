<mujoco model="camera_scene">
  <!-- Standalone RGB-D camera scene: just a camera, a floor, and two simple
       objects to give the depth image real edges/features to check against.
       No door, no robot — see rgbd_camera.xml for how to reuse the camera
       fragment itself when mounting it on a robot later. -->
  <compiler angle="radian"/>
  <option timestep="0.002" gravity="0 0 -9.81"/>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.8 0.9 1" rgb2="0.3 0.4 0.5" width="256" height="256"/>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.2 0.2 0.2" rgb2="0.3 0.3 0.3" width="300" height="300"/>
    <material name="grid" texture="grid" texrepeat="5 5" reflectance="0.1"/>
  </asset>

  <worldbody>
    <light pos="0 -1 3" dir="0 0.3 -1" diffuse="1 1 1"/>
    <geom name="floor" type="plane" size="3 3 0.1" material="grid"/>

    <!-- Depth-test targets: known size/pose/color, nothing else in the scene. -->
    <body name="test_box" pos="0 0.3 0.25">
      <geom name="test_box_geom" type="box" size="0.15 0.15 0.25" rgba="0.8 0.2 0.2 1"/>
    </body>
    <body name="test_sphere" pos="0.3 -0.4 0.4">
      <geom name="test_sphere_geom" type="sphere" size="0.18" rgba="0.2 0.5 0.9 1"/>
    </body>

    <!-- Camera mount: a free-standing body today. To reuse the camera
         elsewhere (e.g. on a robot link), include rgbd_camera.xml inside
         that body instead — see the comments in that file. -->
    <body name="camera_mount" pos="1.6 0 0.9" xyaxes="0 1 0 -0.298275 0 0.95448">
      <include file="rgbd_camera.xml"/>
    </body>
  </worldbody>
</mujoco>

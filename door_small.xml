<mujoco model="single_hinge_door_small">
  <compiler angle="radian"/>
  <option timestep="0.002" gravity="0 0 -9.81"/>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.8 0.9 1" rgb2="0.3 0.4 0.5" width="256" height="256"/>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.2 0.2 0.2" rgb2="0.3 0.3 0.3" width="300" height="300"/>
    <material name="grid" texture="grid" texrepeat="5 5" reflectance="0.1"/>
  </asset>

  <worldbody>
    <light pos="0 -1 2" dir="0 0.3 -1" diffuse="1 1 1"/>
    <geom name="floor" type="plane" size="3 3 0.1" material="grid"/>

    <geom name="wall" type="box" pos="-0.02 0 0.5" size="0.02 0.4 0.5"
          rgba="0.5 0.5 0.5 1" contype="0" conaffinity="0"/>

    <!-- Small door: half the width/height of door.xml's panel, same
         panel thickness. Same baked density (600) as door.xml so
         load_model's density/DEFAULT_DENSITY scale math still holds;
         frictionloss/damping are overridden from Python per-run. -->
    <body name="door" pos="0 0 0">
      <joint name="hinge" type="hinge" pos="0 0 0" axis="0 0 1"
             limited="true" range="-0.17 2.09"
             damping="0.05" frictionloss="0.6"/>
      <geom name="panel" type="box" pos="0.225 0 0.52" size="0.225 0.02 0.5"
            density="600" rgba="0.8 0.7 0.5 1"/>
      <site name="handle" pos="0.4 0 0.5" size="0.02" rgba="1 0 0 1"/>
    </body>

    <camera name="view" pos="1.3 -1.5 1.1" xyaxes="1 0.9 0 0 0.4 1"/>
  </worldbody>
</mujoco>
